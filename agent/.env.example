# --- Backend connection ---
# URL of Member 1's running backend server (used for /init and /feed).
BACKEND_URL=http://localhost:3001

# --- Persona (used to initialize the agent and shape the writing) ---
AGENT_NAME=TechPulse
AGENT_DOMAIN=AI and technology news
AGENT_TONE=informative and concise

# --- Scheduler ---
# How many minutes to wait between autonomous cycles.
AGENT_INTERVAL_MINUTES=10

# --- AI writer (optional) ---
# Leave AI_API_KEY blank to use the built-in fallback template writer
# (useful for testing the pipeline without any paid/free API key yet).
#
# Works with any OpenAI-compatible chat completions endpoint.
# Example below is set up for Groq's free tier.
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
